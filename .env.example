# ---- Core ----
# Database. Local dev needs nothing — a SQLite file is created at ./data/kmr.db.
# PRODUCTION (Vercel): create a free Turso database (https://turso.tech) and set:
#   DATABASE_URL=libsql://your-db-yourorg.turso.io
#   DATABASE_AUTH_TOKEN=<token from `turso db tokens create`>
# Every serverless instance then shares one persistent database.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Secret used to sign session JWTs. REQUIRED in production — use a long random string.
AUTH_SECRET=change-me-to-a-long-random-string-in-production

# ---- Admin seed (used by db:seed on first run only) ----
#ADMIN_EMAIL=admin@kmr.gg
#ADMIN_PASSWORD=change-this-before-seeding-production

# ---- Payments (Razorpay) ----
# When these are set, the app uses the live Razorpay gateway + Checkout.js.
# When they are empty, the app runs in MOCK gateway mode (built-in simulator) —
# perfect for development and demos, with the exact same order/verify lifecycle.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---- Google sign-in ----
# Google Cloud Console → APIs & Services → Credentials → Create OAuth Client ID
# (Web). Add redirect URI: https://<your-domain>/api/auth/google/callback
# (and http://localhost:3000/api/auth/google/callback for dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Misc ----
NEXT_TELEMETRY_DISABLED=1
